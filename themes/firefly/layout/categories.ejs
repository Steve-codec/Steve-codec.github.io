<%
/**
 * Categories list page matching design mockup.
 */
var sidebar = theme.sidebar || {};
var sidebarPosition = sidebar.position || 'both';
var showLeftSidebar = sidebarPosition === 'both' || sidebarPosition === 'left';
var showRightSidebar = sidebarPosition === 'both' || sidebarPosition === 'right';
var gridClass = 'has-no-sidebar';
if (showLeftSidebar && showRightSidebar) {
  gridClass = 'has-both-sidebars';
} else if (showLeftSidebar) {
  gridClass = 'has-left-sidebar';
} else if (showRightSidebar) {
  gridClass = 'has-right-sidebar';
}

var allCategories = site.categories.sort('length', -1).filter(function(cat) {
  return cat.length > 0;
});
%>

<div id="main-grid" class="main-grid-layout <%= gridClass %>">
  <!-- ===== Left Sidebar ===== -->
  <% if (showLeftSidebar) { %>
  <aside class="sidebar-left" aria-label="<%= __('sidebar.left') %>">
    <%- partial('_partials/post/sidebar-left') %>
  </aside>
  <% } %>

  <!-- ===== Main Content ===== -->
  <main id="main-content" class="categories-container">

    <!-- Header Card -->
    <div class="categories-header-card card-base">
      <h1 class="categories-header-title">分类</h1>
      <p class="categories-header-subtitle">全部分类 · <%= site.posts.length %> 篇文章</p>
    </div>

    <!-- Category Cards Grid -->
    <div class="categories-grid category-folders-grid">
      <% if (allCategories.length > 0) { %>
        <% allCategories.forEach(function(cat) { %>
        <section class="category-folder-card card-base">
          <header class="category-folder-header">
            <div>
              <% var parent = cat.parent ? site.categories.findById(cat.parent) : null; %>
              <p class="category-folder-eyebrow"><%= parent ? parent.name + ' / 子分类' : '笔记收藏夹' %></p>
              <h2><a href="<%= url_for(cat.path) %>"><%= cat.name %></a></h2>
            </div>
            <span class="category-folder-count"><%= cat.posts.length %> 篇</span>
          </header>
          <div class="category-folder-visual" data-label="<%= cat.name %>">
            <span class="category-folder-fallback material-symbols-outlined" aria-hidden="true">folder</span>
          </div>
          <p class="category-folder-hint">点击文件夹，翻开这份收藏</p>
          <div class="category-folder-posts" aria-label="<%= cat.name %>的文章">
            <% cat.posts.sort('date', -1).limit(3).forEach(function(post) { %>
            <a href="<%= url_for(post.path) %>" class="category-folder-post">
              <span class="category-folder-post-date"><%= date(post.date, 'YYYY.MM.DD') %></span>
              <span><%= post.title %></span>
              <span aria-hidden="true">↗</span>
            </a>
            <% }); %>
          </div>
          <a href="<%= url_for(cat.path) %>" class="category-folder-browse">查看全部文章 <span aria-hidden="true">→</span></a>
        </section>
        <% }); %>
      <% } else { %>
      <div class="categories-empty card-base">
        <p><%= __('category.empty') %></p>
      </div>
      <% } %>
    </div>
  </main>

  <!-- ===== Right Sidebar ===== -->
  <% if (showRightSidebar) { %>
  <aside class="sidebar-right" aria-label="<%= __('sidebar.right') %>">
    <%- partial('_partials/post/sidebar-right') %>
  </aside>
  <% } %>

  <!-- ===== Mobile Bottom Sidebar ===== -->
  <%- partial('_partials/post/mobile-sidebar') %>

  <%- partial('_partials/footer') %>
</div>
