<% if (theme.music && theme.music.mode !== 'none') { %>
<div class="widget music-widget">
  <div class="widget-header">
    <span class="material-symbols-outlined">library_music</span>
    <span><%= __('music') %></span>
  </div>
  <div class="widget-body">
    <% if (theme.music.mode === 'meting' && theme.music.meting) { %>
      <meting-js
        server="<%= theme.music.meting.server || 'netease' %>"
        type="<%= theme.music.meting.type || 'playlist' %>"
        id="<%= theme.music.meting.id || '' %>"
        api="<%= theme.music.meting.api || 'https://api.injahow.cn/meting/?server=:server&type=:type&id=:id&r=:r' %>"
        order="<%= theme.music.play_mode || 'list' %>"
        fixed="false"
        mini="false"
        autoplay="false"
        theme="var(--primary)"
        loop="all"
        preload="auto"
        volume="<%= (theme.music.volume || 0.7) %>"
        mutex="true">
      </meting-js>
    <% } else if (theme.music.mode === 'local') { %>
      <% var playlist = site.data.music && site.data.music.playlist || theme.music.local && theme.music.local.playlist || []; %>
      <% if (playlist.length) { %>
      <div class="aplayer aplayer-local"></div>

      <% } else { %>
      <div class="music-empty"><div class="music-empty-cover"><span class="material-symbols-outlined">music_note</span></div><div class="music-empty-title">我的歌单</div><p>还没有添加音乐</p><div class="music-empty-controls"><button disabled aria-label="上一首"><span class="material-symbols-outlined">skip_previous</span></button><button disabled aria-label="播放"><span class="material-symbols-outlined">play_circle</span></button><button disabled aria-label="下一首"><span class="material-symbols-outlined">skip_next</span></button></div></div>
      <% } %>
    <% } %>
  </div>
</div>


<% } %>
