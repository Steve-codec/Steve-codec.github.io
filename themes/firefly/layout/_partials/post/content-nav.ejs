<%
var currentPath = page.path || '';
var isHome = is_home();
var isPost = is_post();
var isArchive = is_archive();
var isCategory = is_category();
var isTag = is_tag();
var postListDefault = theme.post_list_layout && theme.post_list_layout.default_mode || 'list';
var selectedCategory = false;
%>
<nav class="content-nav-bar card-base" aria-label="内容导航">
  <div class="content-nav-track">
  <!-- Home button -->
  <a href="<%= url_for('/') %>" class="content-nav-item content-nav-home<%= isHome ? ' active' : '' %>" <%- isHome ? 'aria-current="page"' : '' %>>
    <span class="nav-item-label">首页</span>
  </a>
  
  <!-- Archive button -->
  <a href="<%= url_for('/archives') %>" class="content-nav-item<%= (isArchive || page.layout === 'archive' || currentPath.indexOf('archives') === 0) ? ' active' : '' %>" <%- (isArchive || page.layout === 'archive' || currentPath.indexOf('archives') === 0) ? 'aria-current="page"' : '' %>>
    <span class="nav-item-label">归档</span>
    <span class="nav-item-count"><%= site.posts.length %></span>
  </a>

  <!-- Dynamic Categories -->
  <%
  var displayCats = [];
  if (site.categories && site.categories.length > 0) {
    displayCats = site.categories.filter(function(cat) { return cat.length > 0; }).toArray();
    displayCats.sort(function(a, b) { return b.length - a.length; });
    displayCats = displayCats.slice(0, 2); // Top 2 categories
  }
  if (displayCats && displayCats.length > 0) {
    displayCats.forEach(function(cat) {
      var isCurrentCat = false;
      if (isCategory && page.category === cat.name) {
        isCurrentCat = true;
      } else if (isPost && !selectedCategory && page.categories && page.categories.length > 0) {
        isCurrentCat = page.categories.some(function(postCat) {
          return postCat.name === cat.name;
        });
      }
      if (isCurrentCat) selectedCategory = true;
  %>
    <a href="<%= url_for(cat.path) %>" class="content-nav-item<%= isCurrentCat ? ' active' : '' %>" <%- isCurrentCat ? 'aria-current="page"' : '' %>>
      <span class="nav-item-label"><%= cat.name %></span>
      <span class="nav-item-count"><%= cat.posts.length %></span>
    </a>
  <%
    });
  }
  %>

  <!-- More button -->
  <a href="<%= url_for('/categories') %>" class="content-nav-item content-nav-more<%= page.layout === 'categories' ? ' active' : '' %>" <%- page.layout === 'categories' ? 'aria-current="page"' : '' %>>
    <span class="nav-item-label">更多</span>
  </a>
  </div>
</nav>
