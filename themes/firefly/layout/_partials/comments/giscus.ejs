<% if (theme.comments.type === 'giscus' && theme.comments.giscus && theme.comments.giscus.repo && theme.comments.giscus.repo_id && theme.comments.giscus.category_id) { %>
<div class="comments-container">
  <div class="comments-title"><%= __('comments') %></div>
  <p class="comments-login-note">登录 GitHub 后，留下你的想法。</p>
  <div class="giscus-wrapper giscus" id="giscus-container"
       data-repo="<%= theme.comments.giscus.repo %>"
       data-repo-id="<%= theme.comments.giscus.repo_id %>"
       data-category="<%= theme.comments.giscus.category %>"
       data-category-id="<%= theme.comments.giscus.category_id %>"
       data-mapping="<%= theme.comments.giscus.mapping %>"
       data-strict="<%= theme.comments.giscus.strict %>"
       data-reactions-enabled="<%= theme.comments.giscus.reactions_enabled %>"
       data-emit-metadata="<%= theme.comments.giscus.emit_metadata %>"
       data-input-position="<%= theme.comments.giscus.input_position %>"
       data-lang="<%= theme.comments.giscus.lang %>"
       data-loading="<%= theme.comments.giscus.loading %>">
  </div>
  <noscript><a href="https://github.com/<%= theme.comments.giscus.repo %>/discussions">在 GitHub 查看讨论</a></noscript>
</div>
<% } else if (theme.comments.type === 'giscus') { %>
<div class="comments-container">
  <div class="comments-title">评论</div>
  <div class="comment-preview">
    <p>评论区预览 · 欢迎留下你的想法。</p>
    <textarea aria-label="评论预览" placeholder="连接评论服务后，即可在这里留言。" disabled></textarea>
    <div class="comment-preview-footer"><span>尚未连接评论服务，暂时不能发送留言。</span><button disabled>发表评论</button></div>
  </div>
</div>
<% } %>
