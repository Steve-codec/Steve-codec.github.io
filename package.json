{
  "name": "hexo-site",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "node ui-components/build.cjs && hexo generate",
    "clean": "hexo clean",
    "deploy": "hexo deploy",
    "server": "hexo server --ip 127.0.0.1",
    "preview": "hexo server --draft --ip 127.0.0.1",
    "build:ui": "node ui-components/build.cjs",
    "check:content": "node checks/content-expansion.cjs && node checks/content-expansion.cjs --empty",
    "check:player": "node checks/music-controls.cjs && node checks/comments.cjs"
  },
  "hexo": {
    "version": "8.1.2"
  },
  "dependencies": {
    "hexo": "^8.0.0",
    "hexo-front-matter": "^5.0.0",
    "hexo-generator-archive": "^2.0.0",
    "hexo-generator-category": "^2.0.0",
    "hexo-generator-feed": "^4.0.0",
    "hexo-generator-index": "^4.0.0",
    "hexo-generator-search": "^2.4.3",
    "hexo-generator-tag": "^2.0.0",
    "hexo-renderer-ejs": "^2.0.0",
    "hexo-renderer-marked": "^7.0.0",
    "hexo-renderer-pug": "^3.0.0",
    "hexo-renderer-stylus": "^3.0.1",
    "hexo-server": "^3.0.0",
    "hexo-theme-butterfly": "^5.7.0",
    "hexo-theme-landscape": "^1.0.0",
    "hexo-util": "^4.0.0",
    "hexo-wordcount": "^6.0.1",
    "image-size": "^2.0.4",
    "katex": "^0.18.0",
    "marked-katex-extension": "^5.1.13",
    "moment": "^2.31.0",
    "motion": "^14.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3"
  }
}
